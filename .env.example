# Jace Games — copy to .env.local and fill in. Never commit the real values.

# From Jace: profile → Manage account → Developer, signed in as the site owner
# (so Jace Games counts as an official app).
JACE_CLIENT_ID=
JACE_CLIENT_SECRET=

# 32+ random characters used to encrypt the session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Defaults to https://jaceo.vercel.app
# JACE_URL=https://jaceo.vercel.app

# Optional. The public URL of this app, used to build the OAuth redirect URI
# (<APP_URL>/api/auth/callback). Defaults to the URL of the incoming request.
# APP_URL=http://localhost:3000

# Multiplayer (Supabase project "jace-games"). Optional in development:
# without them rooms use an in-memory store and a local live relay.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Jace Social friend invites. Same value as JACE_GAMES_APP_KEY on Jace Social.
# Generate with: openssl rand -base64 32
# JACE_SOCIAL_URL=https://jace-social.vercel.app
JACE_SOCIAL_APP_KEY=

# Protects the daily room cleanup cron (Vercel sends it automatically).
CRON_SECRET=

# Optional. The Jace user id (userinfo "sub") of the site owner, who can take
# community games down and sees reports. Without it nobody can.
# SITE_OWNER_JACE_ID=
